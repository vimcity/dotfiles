# Ghostty Configuration 
# ==================================================

theme = "catppuccin-rose"
# macos-icon = retro
# macos-icon = glass
# macos-icon = holographic
# macos-icon = xray
# Launch maximized
window-decoration = false
macos-titlebar-style = hidden
window-step-resize = true
window-save-state = always
mouse-hide-while-typing = true

# Font settings
font-feature = -calt
# font-family = "CommitMono"
adjust-cell-height = 10%
# font-family = "FiraCode Nerd Font"
# adjust-cell-height = 40%
# adjust-cell-height = 10%
font-size = 20

# Background
# background-image = ~/dotfiles/ghostty/ghostty-bg.png
# background-image = ~/dotfiles/ghostty/bag.jpg
# background-image-fit = cover
# background-image-position = center
# background-image-opacity = 0.20
# background-blur=true
# background-opacity = 0.95

# Cursor styling: mode-driven block/bar cursor.
cursor-style = block
adjust-cursor-thickness = 4
# custom-shader = shaders/cursor_smear_fade.glsl
# Shell integration
shell-integration = zsh

# Copy on select
copy-on-select = clipboard

# Keybindings
keybind = shift+enter=text:\x1b[13;2u

# Disable Ctrl+Shift+P (conflicts with other tools)
keybind = ctrl+shift+p=unbind

# Vim-like scrollback navigation.
# Enable with Alt+V, then use Vim-style movement/search/copy keys.
keybind = alt+v=activate_key_table:vim
keybind = vim/
keybind = vim/j=scroll_page_lines:1
keybind = vim/k=scroll_page_lines:-1
keybind = vim/ctrl+d=scroll_page_down
keybind = vim/ctrl+u=scroll_page_up
keybind = vim/ctrl+f=scroll_page_down
keybind = vim/ctrl+b=scroll_page_up
keybind = vim/shift+j=scroll_page_down
keybind = vim/shift+k=scroll_page_up
keybind = vim/g>g=scroll_to_top
keybind = vim/shift+g=scroll_to_bottom
keybind = vim/slash=start_search
keybind = vim/n=navigate_search:next
keybind = vim/v=copy_to_clipboard
keybind = vim/y=copy_to_clipboard
keybind = vim/shift+semicolon=toggle_command_palette
keybind = vim/escape=deactivate_key_table
keybind = vim/q=deactivate_key_table
keybind = vim/i=deactivate_key_table
keybind = vim/catch_all=ignore

config-file=?~/local.config
# Quick terminal toggle (Quake-style dropdown terminal)
# keybind = global:cmd+shift+backquote=toggle_quick_terminal
background-blur = false
mouse-scroll-multiplier = 1
