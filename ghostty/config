# vim: ft=conf
# Ghostty Configuration
# ==================================================

theme = "Catppuccin Frappe"
window-decoration = false
window-step-resize = true
window-save-state = always
mouse-hide-while-typing = true

# Icons
# macos-icon = custom
# macos-custom-icon = ~/.config/ghostty/cat-ghostty.icns
# macos-icon = retro
macos-icon = glass
# macos-icon = holographic
# macos-icon = xray

# Font settings
font-feature = -calt
# font-family = "CommitMono"
# font-family = "FiraCode Nerd Font"
# font-family = "GoogleSansCode Nerd Font"
# font-family = "Hack Nerd Font"
# font-family = "Reddit Mono"

adjust-cell-height = 0%
# adjust-cell-height = 40%
# adjust-cell-height = 10%
font-size = 16

# Background
# background-image = ~/dotfiles/ghostty/ghostty-bg.png
# background-image = ~/dotfiles/ghostty/bag.jpg
# background-image-fit = cover
# background-image-position = center
# background-image-opacity = 0.10
# background-blur=true
# background-opacity = 0.98

cursor-style = block
adjust-cursor-thickness = 4
custom-shader = shaders/cursor_smear_fade.glsl

shell-integration = zsh

# OSC 52 — required for Neovim/yanks over Herdr remote and SSH
clipboard-read = allow
clipboard-write = allow

# Copy on select
copy-on-select = clipboard

# Keep Alt-f as an explicit Meta-f sequence so Vim and shell vi mode both receive it.
keybind = alt+f=text:\x1bf

# (conflicts with other tools)
keybind = ctrl+shift+p=unbind



# Quick terminal toggle (Quake-style dropdown terminal)
keybind = global:cmd+shift+backquote=toggle_quick_terminal
background-blur = true
mouse-scroll-multiplier = 1
