{
  "id": "root",
  "cloned_from": {
    "name": "main",
    "version": "0.1.13"
  },
  "type": "row",
  "children": [
    {
      "id": "metrics-controller",
      "type": "block",
      "content": {
        "mod": "minimal-metrics"
      },
      "size": {
        "px": 0
      },
      "min": 0,
      "max": 0
    },
    {
      "id": "sidebar",
      "type": "column",
      "children": [
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "content": {
                "mod": "minimal-sidebar"
              },
              "size": {
                "weight": 1
              },
              "min": 90
            },
            {
              "id": "agents",
              "type": "block",
              "content": {
                "mod": "minimal-agents"
              },
              "size": {
                "weight": 1
              },
              "min": 90,
              "hidden": true
            }
          ],
          "divider": {
            "width": 1,
            "color": "border"
          }
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "content": {
            "mod": "workspace-chrome",
            "props": {
              "footer": true
            }
          },
          "size": {
            "px": 69
          },
          "hidden": true
        }
      ],
      "size": {
        "px": 275
      },
      "min": 76,
      "max": 480,
      "background": "chrome",
      "resizable": false
    },
    {
      "id": "work",
      "type": "column",
      "background": "chrome",
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "content": {
            "mod": "tabs"
          },
          "size": {
            "px": 42
          },
          "hidden": true,
          "window_drag": true
        },
        {
          "id": "work-body",
          "type": "row",
          "background": "chrome",
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "header": {
                    "content": {
                      "mod": "minimal-pane"
                    },
                    "reveal": "always",
                    "height": 32,
                    "position": "top"
                  },
                  "background": "background",
                  "border": {
                    "width": 0.5,
                    "color": "#ffffff0a"
                  },
                  "focus": {
                    "width": 0.5,
                    "color": "#ffffff28"
                  },
                  "radius": 10,
                  "gap": 8,
                  "lone": true
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "herdr-nvim",
                        "props": {
                          "replaces": {
                            "mod": "files"
                          }
                        }
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "changes-close"
                      }
                    }
                  ],
                  "active": "changes"
                }
              ],
              "size": {
                "px": 182
              },
              "min": 280,
              "max": 3000,
              "hidden": true
            }
          ],
          "padding": [
            6,
            8
          ],
          "gap": 8
        },
        {
          "id": "status",
          "type": "block",
          "content": {
            "mod": "workspace-status"
          },
          "size": {
            "px": 28
          },
          "hidden": true
        }
      ],
      "resizable": false
    }
  ],
  "background": "canvas",
  "theme": {
    "light": "catppuccin-frappe",
    "dark": "catppuccin-frappe"
  },
  "colors": {
    "accent": "#babbf1",
    "border": "#42475b",
    "canvas": "#292d3e",
    "chrome": "#292d3e",
    "cursor": "#C6D0F5",
    "dim": "#838BA7",
    "foreground": "#C6D0F5",
    "hover": "#353b50",
    "input": "#59617d",
    "muted": "#A5ADCE",
    "selected": "#454c64"
  },
  "terminal_padding": [
    8,
    12
  ],
  "titlebar": "none",
  "traffic_lights": [
    12,
    11
  ],
  "floating": [
    {
      "id": "herdr-nvim-sync",
      "content": {
        "mod": "herdr-nvim",
        "props": {
          "role": "sync"
        }
      },
      "edge": "bottom",
      "align": "end"
    }
  ]
}
