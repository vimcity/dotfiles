#!/bin/sh
set -eu
mod_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
export HERDR_NVIM_HOST=app
export HERDR_NVIM_SELF="$mod_dir/bin/herdr-nvim"
export HERDR_NVIM_PLUGIN_ROOT="$mod_dir/runtime"
export HERDR_APP_HOME="${HERDR_APP_HOME:-$(dirname -- "$(dirname -- "$mod_dir")")}"
export HERDR_APP_BIN="${HERDR_APP_BIN:-$(command -v herdr-app)}"
case "$(uname -s)/$(uname -m)" in
 Darwin/arm64) exec "$mod_dir/runtime/bin/herdr-nvim" "$@" ;;
 *) echo 'Bundled herdr-nvim runtime requires Apple Silicon macOS.' >&2; exit 1 ;;
esac
