#!/usr/bin/env bash
set -euo pipefail

MODE="${1:-password}"  # password|username|totp

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=_rbw-common.sh
source "$SCRIPT_DIR/_rbw-common.sh"

if [[ -z "${QUTE_FIFO:-}" ]]; then
    echo "bw-copy: QUTE_FIFO is not set" >&2
    exit 1
fi

HOST="$(rbw_host_from_url || true)"
if [[ -z "$HOST" ]]; then
    rbw_qute_msg message-error "No hostname in current URL"
    exit 1
fi

if ! command -v rbw >/dev/null 2>&1; then
    rbw_qute_msg message-error "rbw not installed. Run: brew install rbw"
    exit 1
fi

selected="$(rbw_first_entry || true)"
if [[ -z "$selected" ]]; then
    rbw_qute_msg message-error "No rbw login found for ${HOST}"
    exit 1
fi

IFS=$'\t' read -r username entry_name <<< "$selected"

case "$MODE" in
    username)
        VALUE="$(rbw get "$entry_name" "$username" --field username 2>/dev/null || true)"
        LABEL="username"
        ;;
    totp)
        VALUE="$(rbw code "$entry_name" "$username" 2>/dev/null || true)"
        LABEL="TOTP"
        ;;
    *)
        VALUE="$(rbw get "$entry_name" "$username" 2>/dev/null || true)"
        LABEL="password"
        ;;
esac

if [[ -z "$VALUE" ]]; then
    rbw_qute_msg message-error "Requested ${LABEL} empty for ${HOST}"
    exit 1
fi

printf '%s' "$VALUE" | pbcopy
rbw_qute_msg message-info "rbw ${LABEL} copied for ${HOST}"
