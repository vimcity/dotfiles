{
  "$schema": "https://raw.githubusercontent.com/fencesandbox/fence/main/docs/schema/fence.schema.json",

  // Start from code-relaxed — gives us the correct Seatbelt profile
  // for coding agents. Add our customizations on top.
  "extends": "code-relaxed",

  // ── Filesystem ────────────────────────────────────────────────────
  "filesystem": {
    "denyRead": [
      // DenyRead from code-relaxed is inherited, add more:
      "~/.zshenv",
      "**/*.env",
      "~/.config/gh/hosts.yml",
      "~/.config/gh/oauth.yml",
      "~/.npmrc",
      "~/.zshrc.local.env",
      "~/.m2/settings.xml",
      "~/.pi/agent/auth.json"
    ],
    "denyWrite": [
      // Inherits denyWrite from code-relaxed, add more:
      "~/.zshenv",
      "~/.bashrc",
      "~/.bash_profile",
      "~/.profile"
    ],
    "allowWrite": [
      // Inherits agent directories from code-relaxed; add only tool-specific caches.
      "~/.pi-lens",
      "~/.pi-lens/**",
      "~/dotfiles/**"
    ]
  },

  // ── Network ───────────────────────────────────────────────────────
  "network": {
    // Inherits Fence's explicit provider, source-control, and package-registry
    // allowlist from code-relaxed. Web research must use an allowed provider;
    // no personal SearXNG endpoint is configured in shared dotfiles.
  },

  // ── Commands ──────────────────────────────────────────────────────
  "command": {
    // Inherits command.deny from code-relaxed (git push, sudo, gh publish, etc.)
    // Add more:
    "deny": [
      "git push --force",
      "git push -f",
      "git push origin main --force",
      "git push origin master --force",
      "git gc --aggressive",
      "git prune",
      "git filter-branch",
      "rm -rf /",
      "rm -rf ~",
      "sudo rm",
      "sudo dd",
      "sudo shutdown",
      "sudo reboot",
      "sudo halt",
      "chmod -R 777 /",
      "chmod -R 777 ~",
      "chown -R",
      "curl | sh",
      "curl | bash",
      "curl | zsh",
      "wget -O - | sh",
      "wget -O - | bash",
      "ssh-keygen -t rsa",
      "ssh-keygen -t ed25519",
      "aws ec2 terminate-instances",
      "aws ec2 delete-security-group",
      "aws ec2 delete-key-pair",
      "aws ec2 delete-snapshot",
      "aws ec2 delete-volume",
      "aws ec2 delete-vpc",
      "aws ec2 delete-subnet",
      "aws ec2 delete-route-table",
      "aws ec2 delete-internet-gateway",
      "aws ec2 delete-nat-gateway",
      "aws ec2 delete-network-acl",
      "aws ec2 delete-launch-template",
      "aws ec2 release-address",
      "aws ec2 modify-instance-attribute",
      "aws s3 rb",
      "aws s3 rm --recursive",
      "aws s3api delete-bucket",
      "aws s3api delete-objects",
      "aws s3api put-bucket-policy",
      "aws s3api put-bucket-acl",
      "aws s3api put-bucket-public-access-block",
      "aws iam delete-user",
      "aws iam delete-role",
      "aws iam delete-policy",
      "aws iam delete-group",
      "aws iam create-user",
      "aws iam create-role",
      "aws iam create-access-key",
      "aws iam attach-user-policy",
      "aws iam attach-role-policy",
      "aws iam put-user-policy",
      "aws iam put-role-policy",
      "aws iam update-assume-role-policy",
      "aws rds delete-db-instance",
      "aws rds delete-db-cluster",
      "aws rds delete-db-snapshot",
      "aws lambda delete-function",
      "aws lambda delete-function-url-config",
      "aws lambda add-permission",
      "aws lambda remove-permission",
      "aws lambda update-function-code",
      "aws lambda update-function-configuration",
      "aws dynamodb delete-table",
      "aws cloudformation delete-stack",
      "aws cloudformation delete-change-set",
      "aws eks delete-cluster",
      "aws eks delete-nodegroup",
      "aws ecr delete-repository",
      "aws ecr batch-delete-image",
      "aws kms schedule-key-deletion",
      "aws kms disable-key",
      "aws secretsmanager delete-secret",
      "aws secretsmanager put-secret-value",
      "aws route53 delete-hosted-zone",
      "aws route53 change-resource-record-sets",
      "aws cloudtrail delete-trail",
      "aws cloudtrail stop-logging",
      "aws redshift delete-cluster",
      "aws kinesis delete-stream",
      "aws efs delete-file-system",
      "aws athena delete-data-catalog",
      "aws athena delete-work-group",
      "aws glue delete-database",
      "aws glue delete-table",
      "aws glue delete-crawler",
      "aws glue delete-job",
      "aws glue delete-dev-endpoint"
    ]
  }
}
