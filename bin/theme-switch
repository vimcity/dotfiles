#!/usr/bin/env bash
set -euo pipefail

state_dir="${XDG_CONFIG_HOME:-$HOME/.config}/dotfiles"
state_file="$state_dir/theme"
current=""
[[ -f "$state_file" ]] && current=$(<"$state_file")

case "${1:-toggle}" in
  rose|catppuccin-rose) theme="catppuccin-rose" ;;
  frappe|catppuccin) theme="catppuccin" ;;
  toggle)
    [[ "$current" == "catppuccin" ]] && theme="catppuccin-rose" || theme="catppuccin"
    ;;
  *)
    printf 'Usage: theme-switch [rose|frappe|toggle]\n'
    exit 2
    ;;
esac

mkdir -p "$state_dir"
printf '%s\n' "$theme" >"$state_file"

# Herdr has its own custom palette; update it alongside the shell state.
herdr_config="$HOME/.config/herdr/config.toml"
if [[ -w "$herdr_config" ]]; then
  python3 - "$herdr_config" "$theme" <<'PY'
import pathlib
import re
import sys

path = pathlib.Path(sys.argv[1])
theme = sys.argv[2]
text = path.read_text()
if theme == "catppuccin":
    values = {
        "panel_bg": "#303446", "surface0": "#414559", "surface1": "#51576d",
        "surface_dim": "#292c3c", "overlay0": "#626880", "text": "#c6d0f5",
        "subtext0": "#a5adce", "accent": "#8caaee",
    }
else:
    values = {
        "panel_bg": "#29273f", "surface0": "#2a273f", "surface1": "#393552",
        "surface_dim": "#1f1d30", "overlay0": "#56526e", "text": "#c0bbce",
        "subtext0": "#8a84a0", "accent": "#7287fd",
    }
for key, value in values.items():
    text = re.sub(rf'(?m)^{key} = "[^"]*"$', f'{key} = "{value}"', text)
path.write_text(text)
PY
  command herdr server reload-config >/dev/null 2>&1 || true
fi

# Ghostty reads its theme from the tracked config; keep this selector reversible.
ghostty_config="$HOME/.config/ghostty/config"
if [[ -w "$ghostty_config" ]]; then
  if [[ "$theme" == "catppuccin" ]]; then
    sed -i '' 's/^theme = .*/theme = Catppuccin Frappe/' "$ghostty_config"
  else
    sed -i '' 's/^theme = .*/theme = catppuccin-rose/' "$ghostty_config"
  fi
fi

printf 'Theme set to %s. New shells and newly opened apps will use it.\n' "$theme"
printf 'Run `source ~/.zshrc` in this shell; restart/reload Neovim and Ghostty if needed.\n'
