#!/usr/bin/env bash

set -euo pipefail

export PATH="$HOME/.local/bin:$HOME/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"

OMLX_API_BASE="${OMLX_API_BASE:-http://127.0.0.1:8000/v1}"
OMLX_API_KEY="${OMLX_API_KEY:-local}"
ANONYMIZE_OMLX_MODEL="${ANONYMIZE_OMLX_MODEL:-Qwen2.5-Coder-32B-Instruct-4bit}"

notify() {
    if command -v tmux >/dev/null 2>&1 && [[ -n "${TMUX:-}" ]]; then
        tmux display-message "$1"
    else
        printf '%s\n' "$1" >&2
    fi
}

require_command() {
    if ! command -v "$1" >/dev/null 2>&1; then
        notify "anon clip: missing $1"
        exit 0
    fi
}

ensure_omlx() {
    curl -sf --max-time 2 "${OMLX_API_BASE%/}/models" >/dev/null 2>&1
}

omlx_chat() {
    local model="$1"
    local prompt="$2"
    local input="$3"
    local payload

    payload="$(python3 - <<'PY' "$model" "$prompt" "$input"
import json, sys
model, prompt, user = sys.argv[1:4]
print(json.dumps({
    "model": model,
    "temperature": 0.2,
    "messages": [
        {"role": "system", "content": prompt},
        {"role": "user", "content": user},
    ],
}))
PY
)"

    curl -sf "${OMLX_API_BASE%/}/chat/completions" \
        -H "Content-Type: application/json" \
        -H "Authorization: Bearer ${OMLX_API_KEY}" \
        -d "$payload" | python3 - <<'PY'
import json, sys
data = json.load(sys.stdin)
print(data["choices"][0]["message"]["content"])
PY
}

require_command pbpaste
require_command pbcopy
require_command curl
require_command python3

input_text="$(pbpaste)"

if [[ -z "${input_text//[[:space:]]/}" ]]; then
    notify "anon clip: clipboard empty"
    exit 0
fi

if ! ensure_omlx; then
    notify "anon clip: oMLX not reachable"
    exit 0
fi

prompt=$(cat <<'EOF'
Anonymize following text.

Rules:
- Replace names, emails, phone numbers, addresses, URLs, company names, IDs, ticket numbers, account numbers, repo names, hostnames, IPs, secrets, and any other identifying details with neutral placeholders.
- Preserve technical meaning, structure, formatting, code fences, and debugging value.
- Keep language same.
- Use consistent placeholders when same entity appears multiple times.
- Do not add explanation.
- Output only anonymized text.
EOF
)

anonymized_text="$(omlx_chat "$ANONYMIZE_OMLX_MODEL" "$prompt" "$input_text")" || {
    notify "anon clip: oMLX request failed"
    exit 0
}

if [[ -z "${anonymized_text//[[:space:]]/}" ]]; then
    notify "anon clip: model returned empty output"
    exit 0
fi

printf '%s' "$anonymized_text" | pbcopy
printf '%s' "$anonymized_text"
