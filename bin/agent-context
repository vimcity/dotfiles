#!/usr/bin/env bash
set -euo pipefail

context_file="${AGENT_CONTEXT_FILE:-$HOME/Documents/org/agent-context.md}"

case "${1:-}" in
  add)
    shift
    [[ $# -gt 0 ]] || { echo "usage: agent-context add <concise note>" >&2; exit 2; }
    mkdir -p "$(dirname "$context_file")"
    if [[ ! -f "$context_file" ]]; then
      printf '# Agent context\n\nDurable, concise notes shared across local coding agents. Read only when relevant.\n\n' > "$context_file"
    fi
    printf -- '- %s — %s\n' "$(date '+%Y-%m-%d %H:%M')" "$*" >> "$context_file"
    printf '%s\n' "$context_file"
    ;;
  show)
    [[ -f "$context_file" ]] && tail -n "${2:-80}" "$context_file" || true
    ;;
  *)
    echo "usage: agent-context {add <concise note>|show [lines]}" >&2
    exit 2
    ;;
esac
