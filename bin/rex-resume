#!/usr/bin/env python3
"""Record and explicitly recover agent sessions in Rex panes."""
import datetime as dt
import hashlib
import json
import os
from pathlib import Path
import shlex
import subprocess
import sys
import tempfile


def root():
    return Path(os.environ.get('REX_RESUME_DIR', str(Path.home() / '.local/state/rex-resume')))


def record_path(block):
    return root() / (hashlib.sha256(block.encode()).hexdigest() + '.json')


def records():
    result = {}
    legacy = root() / '.json'
    if legacy.exists():
        for line in legacy.read_text().splitlines():
            item = json.loads(line)
            result[item['block']] = item
    for path in sorted(root().glob('*.json')):
        if path.name.startswith('.'):
            continue
        item = json.loads(path.read_text())
        result[item['block']] = item
    return result


def command(item):
    ref = item.get('session_ref')
    if not isinstance(ref, str) or not ref:
        raise ValueError('No resumable session reference recorded')
    updated = dt.datetime.fromisoformat(item['updated_at'].replace('Z', '+00:00'))
    if dt.datetime.now(dt.timezone.utc) - updated > dt.timedelta(days=14):
        raise ValueError('Record is older than 14 days')
    args = {'pi': ['pi', '--session'], 'codex': ['codex', 'resume'],
            'claude': ['claude', '--resume']}[item['agent']] + [ref]
    return 'cd -- ' + shlex.quote(item['cwd']) + ' && ' + shlex.join(args)


def main():
    action = sys.argv[1] if len(sys.argv) > 1 else 'record'
    block = sys.argv[2] if len(sys.argv) > 2 else os.environ.get('REX_BLOCK')
    if action == 'record':
        session = os.environ.get('REX_SESSION')
        if not session or not block:
            raise ValueError('REX_SESSION and REX_BLOCK are required')
        raw = sys.stdin.read() if not sys.stdin.isatty() and not os.environ.get('REX_RESUME_AGENT_PID') else ''
        payload = json.loads(raw) if raw.strip() else {}
        agent = os.environ.get('REX_RESUME_AGENT')
        refs = {'pi': 'PI_SESSION_FILE', 'codex': 'CODEX_THREAD_ID', 'claude': 'CLAUDE_SESSION_ID'}
        if agent not in refs:
            raise ValueError('REX_RESUME_AGENT must be pi, codex, or claude')
        ref = os.environ.get(refs[agent]) or payload.get('session_id')
        if not ref:
            raise ValueError('Missing agent session reference; existing record preserved')
        pid = int(os.environ.get('REX_RESUME_AGENT_PID', '0')) or None
        item = dict(agent=agent, session_ref=ref, cwd=payload.get('cwd') or os.getcwd(),
                    pid=pid, block=block, rex_session=session,
                    updated_at=dt.datetime.now(dt.timezone.utc).isoformat())
        root().mkdir(parents=True, exist_ok=True, mode=0o700)
        fd, temporary = tempfile.mkstemp(dir=root(), prefix='.record-')
        try:
            with os.fdopen(fd, 'w') as stream:
                json.dump(item, stream)
            os.replace(temporary, record_path(block))
        finally:
            if os.path.exists(temporary):
                os.unlink(temporary)
        return
    items = records()
    if action == 'list':
        for item in items.values():
            print(json.dumps(item))
    elif action == 'resume':
        if block not in items:
            raise ValueError('No record for this pane')
        print(command(items[block]))
    elif action == 'restore':
        if not block or block not in items:
            raise ValueError('restore requires a recorded block ID')
        item = items[block]
        process = json.loads(subprocess.check_output(['rex', 'block', 'call', '-s', item['rex_session'], '-b', block, 'process'], text=True))
        name = process.get('foreground', {}).get('name', '').lstrip('-')
        if name not in ('zsh', 'bash', 'sh', 'fish'):
            raise ValueError('Refusing to send input: pane is not at a shell')
        if name == 'fish':
            raise ValueError('fish restore is not supported; use resume to inspect the command')
        cmd = command(item)
        subprocess.run(['rex', 'send', '-s', item['rex_session'], '-b', block, cmd], check=True)
        subprocess.run(['rex', 'send-key', '-s', item['rex_session'], '-b', block, 'enter'], check=True)
    else:
        raise ValueError('Usage: rex-resume record|list|resume [block]|restore block')


if __name__ == '__main__':
    try:
        main()
    except (ValueError, KeyError, OSError, subprocess.CalledProcessError) as error:
        print(f'rex-resume: {error}', file=sys.stderr)
        sys.exit(1)
